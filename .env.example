# ── Khusela Consent configuration ─────────────────────────────────────────────
# Copy to .env for local development. Never commit .env.

PORT=3000
NODE_ENV=development
STORAGE_DIR=./storage

# The public address clients and agents open. Every signing link is built from
# this, so it must be reachable from the client's phone. On Render leave it
# empty: the service uses RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=http://localhost:3000

# The first administrator, created only when the agents table is empty.
# Use a long password (10+ characters, letters and numbers).
ADMIN_EMAIL=khuselamanagement@gmail.com
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_PASSWORD
ADMIN_NAME=Khusela Administrator

# Sessions expire after this many hours (1–168).
SESSION_HOURS=12

# A consent link expires after this many days (1–30).
TOKEN_EXPIRY_DAYS=7

# Login limit per address + email, and the window in milliseconds.
LOGIN_LIMIT=8
LOGIN_WINDOW_MS=900000

# Number of reverse proxies between the internet and Node. Render appends the
# real client address to X-Forwarded-For but does not remove values supplied by
# the client, so trust exactly one hop there. Use 0 for a direct local run.
TRUST_PROXY_HOPS=0

# ── Database ─────────────────────────────────────────────────────────────────
# Empty: local SQLite file at STORAGE_DIR/khusela-consent.db.
# Set: hosted Turso database (recommended in production — Render's free disk is
# wiped on every deploy).
#TURSO_DATABASE_URL=libsql://khusela-consent-yourname.turso.io
#TURSO_AUTH_TOKEN=
